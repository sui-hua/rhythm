{
  "name": "rhythm-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @rhythm/web dev",
    "build": "pnpm --filter @rhythm/web build",
    "preview": "pnpm --filter @rhythm/web preview",
    "type-check": "pnpm --filter @rhythm/web type-check",
    "web:test": "pnpm --filter @rhythm/web test:unit",
    "web:test:e2e": "pnpm --filter @rhythm/web test:e2e",
    "mobile": "pnpm --filter @rhythm/mobile start",
    "mobile:web": "pnpm --filter @rhythm/mobile web",
    "mobile:typecheck": "pnpm --filter @rhythm/mobile typecheck",
    "mobile:test": "pnpm --filter @rhythm/mobile test",
    "api": "pnpm --filter @rhythm/api start:dev",
    "api:build": "pnpm --filter @rhythm/api build",
    "api:start": "pnpm --filter @rhythm/api start:prod",
    "api:test": "pnpm --filter @rhythm/api test:e2e",
    "db:seed": "pnpm --filter @rhythm/api db:seed",
    "next:dev": "pnpm --filter @rhythm/web-next dev",
    "next:build": "pnpm --filter @rhythm/web-next build",
    "next:typecheck": "pnpm --filter @rhythm/web-next typecheck"
  }
}
