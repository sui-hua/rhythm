# 服务端口：3001 避开 web(Vite 5173) 与 web-next(Next 3000)
PORT=3001

# 监听地址：0.0.0.0 便于 Expo 真机通过局域网 IP 联调
HOST=0.0.0.0

# 允许跨域的来源，逗号分隔；留空则放行全部（仅限开发环境）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081

# 本地 Postgres（docker compose up -d 起的那台）
DATABASE_URL="postgresql://root:123456@localhost:5432/rhythm"

